<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".forget_password"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingVertical="@dimen/screen_padding_vertical">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgetPass_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/blue"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center"
        android:fontFamily="@font/robotomono_bold"
        />


    <EditText
        android:id="@+id/etEmail"
        style="@style/InputField"
        android:hint="@string/email_hint"
        android:inputType="textEmailAddress"
        android:drawableLeft="@drawable/icon_email"
        />
    <EditText
        android:id="@+id/etPassword"
        style="@style/InputField"
        android:hint="@string/password_hint"
        android:inputType="textPassword"
        android:drawableLeft="@drawable/icon_key"
        />
    <EditText
        android:id="@+id/etConfirmPassword"
        style="@style/InputField"
        android:hint="@string/confirm_password_hint"
        android:inputType="textPassword"
        android:drawableLeft="@drawable/icon_key"
        />
    <Button
        android:id="@+id/btnSignIn"
        style="@style/PrimaryButton"
        android:text="Change Password"
        app:backgroundTint="@null"
        />

</LinearLayout>