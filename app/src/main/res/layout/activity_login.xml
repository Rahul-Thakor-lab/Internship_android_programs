<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".login"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingVertical="@dimen/screen_padding_vertical"
    >

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login Here"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/blue"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center"
        android:fontFamily="@font/robotomono_bold"
        />

    <TextView
        android:id="@+id/tvTitleMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Welcome back you've been missed!"
        android:textColor="#6B7280"
        android:textSize="23sp"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="70dp"
        android:layout_marginBottom="15dp"
        android:fontFamily="@font/robotomono_semibold"
        />

    <EditText
        android:id="@+id/etEmail"
        style="@style/InputField"
        android:hint="@string/email_hint"
        android:inputType="textEmailAddress"
        android:drawableStart="@drawable/icon_email"
        />

    <EditText
        android:id="@+id/etPassword"
        style="@style/InputField"
        android:hint="@string/password_hint"
        android:inputType="textPassword"
        android:drawableStart="@drawable/icon_padlock"
        />

    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forget Password"
        android:layout_gravity="right"
        android:textColor="@color/blue"
        android:textSize="20sp"
        android:layout_margin="10dp"
        android:fontFamily="@font/robotomono_semibold"
        />

    <Button
        android:id="@+id/btnSignIn"
        style="@style/PrimaryButton"
        android:text="Sign In"
        app:backgroundTint="@null"
      />

    <TextView
        android:id="@+id/tvCreateAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create New Account"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        android:textSize="20sp"
        android:fontFamily="@font/robotomono_semibold"
       />
</LinearLayout>